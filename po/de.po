msgstr "Akkubetrieb, Standard: %s"

#: extension/extension.js:191
#, javascript-format
msgid "On AC power, default: %s"
msgstr "Netzbetrieb, Standard: %s"

#: extension/extension.js:227
msgid "Could not switch TCC profile"
msgstr "TCC-Profil konnte nicht gewechselt werden"

#: extension/prefs.js:21
msgid "Performance"
msgstr "Leistung"

#: extension/prefs.js:22
msgid "Balanced"
msgstr "Ausgeglichen"

#: extension/prefs.js:23
msgid "Power Saver"
msgstr "Energiesparmodus"

#: extension/prefs.js:35
msgid "General"
msgstr "Allgemein"

#: extension/prefs.js:40
msgid "Quick Settings"
msgstr "Schnelleinstellungen"

#: extension/prefs.js:44
msgid "Top Bar Icon"
msgstr "Symbol in der oberen Leiste"

#: extension/prefs.js:45
msgid "Show the profile icon while a profile other than the default is active"
msgstr "Das Profilsymbol anzeigen, solange ein anderes als das Standardprofil aktiv ist"

#: extension/prefs.js:52
msgid "Check Interval"
msgstr "Prüfintervall"

#: extension/prefs.js:53
msgid "Seconds between checks for changes made in the TUXEDO Control Center"
msgstr "Sekunden zwischen zwei Prüfungen auf Änderungen im TUXEDO Control Center"

#: extension/prefs.js:60
msgid "GNOME Power Mode"
msgstr "Energiemodus von GNOME"

#: extension/prefs.js:61
msgid "GNOME's power mode (power-profiles-daemon) and the TUXEDO Control Center change the same CPU settings. The TUXEDO Control Center wins within seconds."
msgstr "Der Energiemodus von GNOME (power-profiles-daemon) und das TUXEDO Control Center ändern dieselben CPU-Einstellungen. Das TUXEDO Control Center setzt sich nach wenigen Sekunden durch."

#: extension/prefs.js:66
msgid "Hide Power Mode Toggle"
msgstr "Energiemodus-Schalter ausblenden"

#: extension/prefs.js:67
msgid "Hide it from the Quick Settings while the TUXEDO Control Center is running, as it would show a mode that no longer applies"
msgstr "In den Schnelleinstellungen ausblenden, solange das TUXEDO Control Center läuft, weil er einen Modus zeigen würde, der nicht mehr gilt"

#: extension/prefs.js:74
msgid "Profiles"
msgstr "Profile"

#: extension/prefs.js:75
msgid "Profiles are created and edited in the TUXEDO Control Center."
msgstr "Profile legen Sie im TUXEDO Control Center an und bearbeiten sie dort."

#: extension/prefs.js:83
msgid "Open TUXEDO Control Center"
msgstr "TUXEDO Control Center öffnen"

#: extension/prefs.js:89
msgid "About Pulsgeber"
msgstr "Info zu Pulsgeber"

#: extension/prefs.js:99
msgid "TUXEDO Control Center service not reachable"
msgstr "Dienst des TUXEDO Control Centers nicht erreichbar"

#: extension/prefs.js:124
msgid "Turn Off power-profiles-daemon"
msgstr "power-profiles-daemon abschalten"

#: extension/prefs.js:125
msgid "Masks the service so that it no longer interferes with the TUXEDO Control Center. Requires administrator rights."
msgstr "Maskiert den Dienst, damit er dem TUXEDO Control Center nicht mehr dazwischenfunkt. Erfordert Administratorrechte."

#: extension/prefs.js:155
msgid "Not authorized"
msgstr "Nicht berechtigt"

#: extension/prefs.js:155
msgid "Could not change power-profiles-daemon"
msgstr "power-profiles-daemon konnte nicht geändert werden"

#: extension/prefs.js:174
msgid "Switches the profiles of the TUXEDO Control Center from the Quick Settings. Unofficial, not affiliated with TUXEDO Computers."
msgstr "Das TUXEDO Control Center überschreibt den Energiemodus nach wenigen Sekunden, der Schalter würde einen Modus zeigen, der nicht mehr giltSchaltet die Profile des TUXEDO Control Centers in den Schnelleinstellungen um. Inoffiziell, keine Verbindung zu TUXEDO Computers."

